{
  // Publica a pasta dist/ como site estático no Cloudflare Workers (static assets).
  // O "name" precisa ser igual ao nome do Worker criado no painel da Cloudflare.
  "name": "keepready",
  "compatibility_date": "2026-11-13",
  // Liga o endereço https://keepready.<subdominio>.workers.dev a cada deploy.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
